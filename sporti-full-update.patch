+{% extends "dashboard/_base.html" %}
+{% load i18n %}
+{% block title %}{% trans "Pronostics" %} — SPORTI{% endblock %}
+{% block dashboard_content %}
+<div class="flex items-center justify-between mb-1">
+    <h1 class="dashboard-page-title mb-0">{% trans "Pronostics" %}</h1>
+    <a href="{% url 'dashboard:prediction_create' %}" class="btn-primary text-xs !px-4 !py-2.5">{% trans "+ Ajouter un pronostic" %}</a>
