DJANGO_SECRET_KEY=change-me-en-production
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://sporti:sporti@localhost:5432/sporti

REDIS_URL=redis://localhost:6379/0

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# --- Stockage des fichiers ---
# "local" pour la V1 (fichiers sur le serveur), "s3" pour basculer vers
# AWS S3 ou Cloudflare R2 plus tard, sans changement de code.
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Notifications push (Web Push API) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:contact@sporti.app

# --- Notifications push (Web Push API) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:contact@sporti.app
