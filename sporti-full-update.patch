+    {% trans "Pronostics visibles par les clients dans le hub." %}
+</p>
+<div class="panel !p-0 overflow-x-auto">
+    <table class="data-table">
+        <thead>
+            <tr>
+                <th class="px-6">{% trans "Match" %}</th>
+                <th>{% trans "Pronostic" %}</th>
+                <th>{% trans "Confiance" %}</th>
+                <th>{% trans "Cote" %}</th>
+                <th>{% trans "Résultat" %}</th>
+                <th>{% trans "Visible" %}</th>
+                <th class="pr-6 text-right">{% trans "Actions" %}</th>
+            </tr>
+        </thead>
+        <tbody>
+            {% for prediction in predictions %}
+            <tr>
+                <td class="px-6 font-medium">
+                    {{ prediction.event }}
+                    {% if prediction.is_featured %}<span class="badge ml-1">★</span>{% endif %}
+                </td>
+                <td class="text-navy-900/60 dark:text-white/50">{{ prediction.pick }}</td>
+                <td class="text-navy-900/60 dark:text-white/50">{{ prediction.confidence|default:"—" }}{% if prediction.confidence %}%{% endif %}</td>
+                <td class="text-navy-900/60 dark:text-white/50">{{ prediction.odds|default:"—" }}</td>
+                <td>
+                    {% if prediction.result == "won" %}
+                        <span class="text-emerald-500 text-xs font-semibold">{% trans "Gagné" %}</span>
+                    {% elif prediction.result == "lost" %}
+                        <span class="text-red-500 text-xs font-semibold">{% trans "Perdu" %}</span>
+                    {% else %}
+                        <span class="text-navy-900/45 dark:text-white/40 text-xs">{% trans "En attente" %}</span>
