+                </td>
+                <td>
+                    {% if prediction.is_published %}
+                        <span class="text-emerald-500 text-xs font-semibold">{% trans "Actif" %}</span>
+                    {% else %}
+                        <span class="text-navy-900/35 dark:text-white/30 text-xs">{% trans "Masqué" %}</span>
+                    {% endif %}
+                </td>
+                <td class="pr-6 text-right whitespace-nowrap">
+                    <a href="{% url 'dashboard:prediction_edit' prediction.id %}" class="btn-ghost !px-2 !py-1 !text-xs">{% trans "Modifier" %}</a>
+                    <form method="post" action="{% url 'dashboard:prediction_delete' prediction.id %}" class="inline"
+                          onsubmit="return confirm('{% trans "Supprimer ce pronostic ?" %}');">
+                        {% csrf_token %}
+                        <button type="submit" class="btn-ghost !px-2 !py-1 !text-xs !text-red-500 hover:!text-red-600">{% trans "Supprimer" %}</button>
+                    </form>
+                </td>
+            </tr>
+            {% empty %}
+            <tr><td colspan="7" class="px-6 py-10 text-center text-navy-900/40 dark:text-white/35">
+                {% trans "Aucun pronostic pour le moment." %}
+            </td></tr>
+            {% endfor %}
+        </tbody>
+    </table>
+</div>
+{% endblock %}
