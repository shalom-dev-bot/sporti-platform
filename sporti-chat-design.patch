
diff --git a/static/css/src/input.css b/static/css/src/input.css
index 5e80454..e79fd36 100644
--- a/static/css/src/input.css
+++ b/static/css/src/input.css
@@ -341,6 +341,122 @@
   .voice-time {
     @apply text-xs tabular-nums text-navy-900/45 dark:text-white/40 shrink-0 w-9 text-right;
   }
+
+  /* --- Chat client SPORTI (maquette V11, fond fixe sombre) --- */
+
+  .sporti-chat-shell {
+    @apply flex flex-col text-white overflow-hidden;
+    height: 100vh;
+    height: 100dvh;
+    height: var(--app-height, 100dvh);
+    background-color: #05070d;
+  }
+
+  .sporti-chat-header {
+    @apply flex items-center justify-between gap-3 px-4 py-3
+           border-b border-white/5 shrink-0;
+  }
+
+  .sporti-chat-avatar {
+    @apply w-10 h-10 rounded-full overflow-hidden border border-cyan-400/30 shrink-0 bg-navy-900 flex items-center justify-center;
+  }
+
+  .sporti-chat-icon-btn {
+    @apply w-9 h-9 rounded-full flex items-center justify-center text-white/75
+           hover:text-white hover:bg-white/5 transition-colors;
+  }
+
+  .sporti-chat-thread {
+    @apply flex-1 min-h-0 overflow-y-auto p-4 space-y-4 flex flex-col;
+  }
+
+  .sporti-date-sep {
+    @apply text-center text-[10px] text-white/45 py-1;
+  }
+
+  .sporti-welcome-card {
+    @apply rounded-2xl bg-[#0b1330] border border-blue-500/20 p-3 text-sm text-white/90 relative shrink-0;
+  }
+
+  .sporti-bubble-row {
+    @apply flex items-start gap-3;
+  }
+
+  .sporti-bubble {
+    @apply max-w-[80%] sm:max-w-[65%] rounded-2xl p-3 text-sm leading-relaxed break-words animate-fade-in-up;
+  }
+
+  .sporti-bubble-admin {
+    @apply sporti-bubble bg-white/5 border border-white/10 text-white;
+  }
+
+  .sporti-bubble-client {
+    @apply sporti-bubble text-white self-end;
+    background: linear-gradient(to bottom, #123db8, #0b2a7a);
+  }
+
+  .sporti-section-label {
+    @apply text-[11px] text-white/50 mb-2;
+  }
+
+  .sporti-platform-badge {
+    @apply px-3 py-2 rounded-md text-[11px] font-semibold text-white inline-flex items-center gap-1.5 transition-transform hover:scale-[1.03];
+  }
+
+  .sporti-social-btn {
+    @apply w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white/80 hover:text-white hover:border-white/25 transition-colors;
+  }
+
+  .sporti-composer-wrap {
+    @apply px-4 py-3 border-t border-white/5 flex items-center gap-2 shrink-0;
+  }
+
+  .sporti-composer-icon-btn {
+    @apply w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/75 shrink-0 hover:text-white hover:border-white/25 transition-colors;
+  }
+
+  .sporti-composer-input {
+    @apply flex-1 h-11 rounded-full bg-white/5 border border-white/10 px-4 text-sm outline-none
+           placeholder:text-white/35 text-white resize-none leading-[2.75rem] py-0 max-h-11 overflow-hidden;
+  }
+
+  .sporti-mic-btn {
+    @apply w-11 h-11 rounded-full bg-[#1f4fff] flex items-center justify-center text-white shrink-0
+           hover:bg-[#285dff] transition-colors;
+  }
+
+  /* Bulle d'accueil + bulles de message : le lecteur vocal reprend la
+     palette bleu/cyan de la maquette au lieu du bleu generique du site. */
+  .sporti-chat-thread .voice-play-btn {
+    @apply bg-[#1f4fff];
+  }
+  .sporti-chat-thread .voice-track {
+    @apply bg-white/10;
+  }
+  .sporti-chat-thread .voice-progress {
+    background: linear-gradient(to right, #22d3ee, #3b82f6);
+  }
+  .sporti-chat-thread .voice-time {
+    @apply text-white/40;
+  }
+  .sporti-chat-thread .typing-dots span {
+    @apply bg-white/40;
+  }
+
+  /* Nav basse : meme fond que la coquille de chat sur cette page precise,
+     sans toucher au style clair/sombre partage par les autres pages. */
+  .sporti-chat-shell .bottom-nav-bar {
+    background-color: #05070d;
+    border-top-color: rgba(255, 255, 255, 0.05);
+  }
+  .sporti-chat-shell .bottom-nav-btn {
+    background-color: transparent;
+    color: rgba(255, 255, 255, 0.55);
+  }
+  .sporti-chat-shell .bottom-nav-btn.active {
+    background-color: transparent;
+    color: #60a5fa;
+  }
 }


